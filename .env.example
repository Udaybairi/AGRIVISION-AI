# AGRIVISION AI - Environment Variables Configuration
# Copy this file to .env and configure your values

# Groq High-Speed LLM Provider
GROQ_API_KEY=
LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile

# Other Providers (Optional)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Local Agriculture Dataset Root Path
AGRICULTURE_DATASET_PATH=C:\Users\uday kumar\Downloads\Agriculture Dataset

# Weather Service API Key
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Server Settings
HOST=127.0.0.1
PORT=5000
DEBUG=False

